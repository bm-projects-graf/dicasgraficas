---
import { getCategory } from '../data/categories';

interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  pubDate: Date;
  readingTime?: string;
}

const { title, description, category, slug, pubDate, readingTime } = Astro.props;

const catColor = getCategory(category)?.color ?? 'var(--color-primary)';

const formattedDate = pubDate.toLocaleDateString('pt-PT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<article class="article-card reveal" style={`--cat: ${catColor}`}>
  <a href={`/artigos/${slug}/`}>
    <div class="article-meta">
      <span class="category">{category}</span>
      {readingTime && <span>{readingTime} de leitura</span>}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="read-more">Ler artigo →</span>
  </a>
</article>
