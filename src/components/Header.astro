---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Início' },
  { href: '/artigos/', label: 'Artigos' },
  { href: '/categorias/', label: 'Categorias' },
  { href: '/sobre/', label: 'Sobre' }
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container">
    <a href="/" class="site-logo" aria-label="dicasgraficas.com — início">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 40 30" xmlns="http://www.w3.org/2000/svg">
          <circle cx="14" cy="12" r="9" fill="#00AEEF" />
          <circle cx="26" cy="12" r="9" fill="#EC008C" />
          <circle cx="20" cy="20" r="9" fill="#FFD200" />
        </svg>
      </span>
      <span class="logo-text">dicasgraficas<span class="dot">.</span>com</span>
    </a>

    <button class="menu-toggle" aria-label="Abrir menu">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

    <nav>
      <ul class="site-nav">
        {navItems.map(item => (
          <li>
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
