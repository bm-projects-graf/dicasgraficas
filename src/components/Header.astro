---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Início' },
  { href: '/categorias/', label: 'Categorias' },
  { href: '/ferramentas/', label: 'Ferramentas' },
  { href: '/glossario/', label: 'Glossário' },
  { href: '/sobre/', label: 'Sobre' }
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container">
    <div class="site-brand">
      <a href="/" class="site-logo" aria-label="dicasgraficas.com — início">
        <span class="logo-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="8" fill="#009FE3" />
            <circle cx="21" cy="11" r="8" fill="#EC008C" />
            <circle cx="11" cy="21" r="8" fill="#FFD200" />
            <circle cx="21" cy="21" r="8" fill="#231F20" />
          </svg>
        </span>
        <span class="logo-text">dicasgraficas<span class="dot">.</span>com</span>
      </a>
      <a href="https://www.ondagrafe.pt" target="_blank" rel="noopener" class="site-byline">by Onda Grafe</a>
    </div>

    <button class="menu-toggle" aria-label="Abrir menu">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

    <nav>
      <ul class="site-nav">
        {navItems.map(item => (
          <li>
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
