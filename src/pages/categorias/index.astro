---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';

const allArticles = await getCollection('articles');

const categoriesWithCount = categories.map(cat => ({
  ...cat,
  count: allArticles.filter(a => a.data.category === cat.title).length
}));
---

<Base
  title="Categorias | dicasgraficas.com"
  description="Explora todos os temas cobertos: preparação de ficheiros, papel, acabamentos, processos, história gráfica, tipografia e mais."
>
  <div class="static-page">
    <div class="container">
      <div class="category-header" style="border-bottom: none; padding-bottom: 1rem;">
        <div class="eyebrow">Navegação por temas</div>
        <h1>Categorias</h1>
        <p>Os temas principais do site, organizados para uma exploração natural do mundo das artes gráficas.</p>
      </div>

      <div class="categories-grid reveal-stagger" style="margin-top: 2rem;">
        {categoriesWithCount.map(cat => (
          <a href={`/categorias/${cat.slug}/`} class="category-card" style={`--cat: ${cat.color}`}>
            <div class="cat-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${cat.icon}</svg>`} />
            <div class="category-number">{cat.number} · {cat.count} {cat.count === 1 ? 'artigo' : 'artigos'}</div>
            <h3>{cat.title}</h3>
            <p>{cat.short}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>
