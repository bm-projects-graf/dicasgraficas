---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categoryMap = [
    { title: 'Preparação de ficheiros', slug: 'preparacao-de-ficheiros', description: 'Tudo o que precisas saber antes de enviar um ficheiro para a gráfica: CMYK, DPI, bleed, formatos, e os erros mais comuns que estragam um trabalho.' },
    { title: 'Papel e suportes', slug: 'papel-e-suportes', description: 'O guia do material que dá vida ao impresso: tipos de papel, gramagens, acabamentos, e como escolher para cada projeto.' },
    { title: 'Acabamentos', slug: 'acabamentos', description: 'Verniz UV, laminados, hot stamping, relevos, encadernações. As técnicas que distinguem um trabalho profissional.' },
    { title: 'Produtos impressos', slug: 'produtos-impressos', description: 'Cartões de visita, flyers, catálogos, embalagens, sinalética. Como cada produto se planeia, desenha e imprime.' },
    { title: 'Processos de impressão', slug: 'processos-de-impressao', description: 'Offset, digital, serigrafia, flexografia, rotogravura. Como funciona cada técnica e quando usar cada uma.' },
    { title: 'História e curiosidades', slug: 'historia-e-curiosidades', description: 'De Gutenberg ao digital: 600 anos de imprensa contados com rigor histórico e leveza narrativa.' },
    { title: 'Ciência da cor', slug: 'ciencia-da-cor', description: 'CMYK, Pantone, ICC profiles, ganho de ponto. A tecnologia por trás das cores que vemos impressas.' },
    { title: 'Tipografia', slug: 'tipografia', description: 'Os mestres do tipo, fontes famosas, e a tradição tipográfica portuguesa.' },
    { title: 'Negócio e marketing', slug: 'negocio-e-marketing', description: 'Como pedir orçamento, escolher a gráfica certa, e fazer o impresso render em campanhas reais.' }
  ];

  return categoryMap.map(cat => ({
    params: { slug: cat.slug },
    props: { category: cat }
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.category === category.title)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Base
  title={`${category.title} | dicasgraficas.com`}
  description={category.description}
>
  <header class="category-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Início</a>
        <span>/</span>
        <a href="/categorias/">Categorias</a>
        <span>/</span>
        <span>{category.title}</span>
      </div>
      <div class="eyebrow">Categoria</div>
      <h1>{category.title}</h1>
      <p>{category.description}</p>
    </div>
  </header>

  <div class="category-articles">
    <div class="container">
      {articles.length > 0 ? (
        <div class="articles-grid">
          {articles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              slug={article.id}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
            />
          ))}
        </div>
      ) : (
        <p style="text-align: center; padding: 3rem 0; color: var(--color-text-secondary);">
          Em breve teremos artigos nesta categoria. Subscreve a newsletter para seres notificado.
        </p>
      )}
    </div>
  </div>
</Base>
