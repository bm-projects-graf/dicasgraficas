---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';
import { byInteresse } from '../../data/article-order';

export async function getStaticPaths() {
  return categories.map(cat => ({
    params: { slug: cat.slug },
    props: { category: cat }
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.category === category.title)
  .sort(byInteresse);
---

<Base
  title={`${category.title} | dicasgraficas.com`}
  description={category.description}
>
  <header class="category-header" style={`--cat: ${category.color}`}>
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Início</a>
        <span>/</span>
        <a href="/categorias/">Categorias</a>
        <span>/</span>
        <span>{category.title}</span>
      </div>
      <div class="category-hero-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${category.icon}</svg>`} />
      <div class="eyebrow">Categoria</div>
      <h1>{category.title}</h1>
      <p>{category.description}</p>
    </div>
  </header>

  <div class="category-articles">
    <div class="container">
      {articles.length > 0 ? (
        <div class="articles-grid">
          {articles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              slug={article.id}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
            />
          ))}
        </div>
      ) : (
        <p style="text-align: center; padding: 3rem 0; color: var(--color-text-secondary);">
          Em breve teremos artigos nesta categoria. Subscreve a newsletter para seres notificado.
        </p>
      )}
    </div>
  </div>
</Base>
