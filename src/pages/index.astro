---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const recentArticles = sortedArticles.slice(0, 6);

const categories = [
  {
    title: 'Preparação de ficheiros',
    description: 'CMYK, DPI, bleed e tudo o que precisas saber antes de enviar para a gráfica.',
    slug: 'preparacao-de-ficheiros',
    number: '01'
  },
  {
    title: 'Papel e suportes',
    description: 'Tipos, gramagens, acabamentos. O guia completo do material que dá vida ao impresso.',
    slug: 'papel-e-suportes',
    number: '02'
  },
  {
    title: 'Acabamentos',
    description: 'Verniz UV, laminados, hot stamping, encadernações. As técnicas que distinguem o profissional.',
    slug: 'acabamentos',
    number: '03'
  },
  {
    title: 'Processos de impressão',
    description: 'Offset, digital, serigrafia, flexografia. Como funciona cada técnica e quando usar.',
    slug: 'processos-de-impressao',
    number: '04'
  },
  {
    title: 'História e curiosidades',
    description: 'De Gutenberg ao digital. Os 600 anos da imprensa contados com rigor e leveza.',
    slug: 'historia-e-curiosidades',
    number: '05'
  },
  {
    title: 'Negócio e marketing',
    description: 'Como pedir orçamento, escolher a gráfica certa e fazer o impresso render.',
    slug: 'negocio-e-marketing',
    number: '06'
  }
];
---

<Base
  title="dicasgraficas.com — Tudo sobre artes gráficas em Portugal"
  description="Recurso independente sobre impressão, papel, acabamentos e processos gráficos. Conselhos práticos e curiosidades para profissionais e curiosos."
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-eyebrow">Dicas e curiosidades sobre artes gráficas</div>
        <h1>O conhecimento gráfico, ao alcance de todos.</h1>
        <p>Conselhos práticos, explicações técnicas e curiosidades sobre o mundo da impressão. De Gutenberg ao digital, de gramagens a acabamentos — tudo o que precisas saber, gratuito e sem agendas comerciais.</p>
      </div>
    </div>
  </section>

  <section class="categories-section">
    <div class="container">
      <h2 class="section-title">Por onde começar</h2>
      <p class="section-subtitle">Os temas principais cobertos pelo site, organizados para uma exploração natural.</p>

      <div class="categories-grid">
        {categories.map(cat => (
          <a href={`/categorias/${cat.slug}/`} class="category-card">
            <div class="category-number">{cat.number} ·</div>
            <h3>{cat.title}</h3>
            <p>{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {recentArticles.length > 0 && (
    <section class="articles-section">
      <div class="container">
        <h2 class="section-title">Artigos recentes</h2>
        <p class="section-subtitle">Os últimos artigos publicados.</p>

        <div class="articles-grid">
          {recentArticles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              slug={article.id}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
            />
          ))}
        </div>

        <p class="text-center mt-2">
          <a href="/artigos/" class="cta-button">Ver todos os artigos →</a>
        </p>
      </div>
    </section>
  )}
</Base>

<style>
  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .cta-button:hover {
    background: var(--color-primary);
    color: white;
  }
</style>
