---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const recentArticles = sortedArticles.slice(0, 3);

// Contagem de artigos por categoria
const categoryCards = categories.map(cat => ({
  ...cat,
  count: allArticles.filter(a => a.data.category === cat.title).length
}));
---

<Base
  title="dicasgraficas.com — Tudo sobre artes gráficas em Portugal"
  description="Recurso independente sobre impressão, papel, acabamentos e processos gráficos. Conselhos práticos e curiosidades para profissionais e curiosos."
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-eyebrow">Dicas e curiosidades sobre artes gráficas</div>
        <h1>O conhecimento gráfico, ao alcance de todos.</h1>
        <p>Conselhos práticos, explicações técnicas e curiosidades sobre o mundo da impressão. De Gutenberg ao digital, de gramagens a acabamentos — tudo o que precisas saber, gratuito e sem agendas comerciais.</p>
      </div>
    </div>
  </section>

  <section class="categories-section">
    <div class="container">
      <h2 class="section-title reveal">Por onde começar</h2>
      <p class="section-subtitle reveal">Nove temas que cobrem o mundo das artes gráficas, de ponta a ponta.</p>

      <div class="categories-grid reveal-stagger">
        {categoryCards.map(cat => (
          <a href={`/categorias/${cat.slug}/`} class="category-card" style={`--cat: ${cat.color}`}>
            <div class="cat-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${cat.icon}</svg>`} />
            <div class="category-number">{cat.number} ·</div>
            <h3>{cat.title}</h3>
            <p>{cat.short}</p>
            <span class="cat-count">{cat.count} {cat.count === 1 ? 'artigo' : 'artigos'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {recentArticles.length > 0 && (
    <section class="articles-section">
      <div class="container">
        <h2 class="section-title reveal">Artigos recentes</h2>
        <p class="section-subtitle reveal">Os últimos artigos publicados.</p>

        <div class="articles-grid articles-grid--three">
          {recentArticles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              category={article.data.category}
              slug={article.id}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
