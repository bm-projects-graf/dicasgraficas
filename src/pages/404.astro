---
import Base from '../layouts/Base.astro';
import { categories } from '../data/categories';
---

<Base
  title="Página não encontrada (404) | dicasgraficas.com"
  description="A página que procuras não existe ou mudou de sítio. Encontra aqui os artigos, as ferramentas e o glossário de artes gráficas."
>
  <div class="static-page">
    <div class="container container-narrow">
      <div class="category-header" style="border-bottom: none; --cat: #C9A227;">
        <div class="eyebrow">Erro 404</div>
        <h1>Esta página saiu do prelo</h1>
        <p>
          O endereço que procuras não existe, ou mudou de sítio. Acontece nas melhores gráficas.
          Segue por aqui, que há muito para ver.
        </p>
      </div>

      <div class="err-links">
        <a href="/artigos/" class="err-btn">Ver todos os artigos</a>
        <a href="/ferramentas/" class="err-btn err-btn--ghost">Ferramentas interativas</a>
        <a href="/glossario/" class="err-btn err-btn--ghost">Glossário</a>
      </div>

      <h2 class="err-h2">Ou escolhe um tema</h2>
      <div class="err-cats">
        {categories.map(c => (
          <a href={`/categorias/${c.slug}/`} class="err-cat" style={`--cat: ${c.color}`}>{c.title}</a>
        ))}
      </div>
    </div>
  </div>

  <style>
    .err-links { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1.5rem 0 2.5rem; }
    .err-btn {
      display: inline-block; padding: 0.7rem 1.2rem; border-radius: 10px;
      background: var(--color-primary); color: #fff; font-weight: 600; text-decoration: none;
      border: 1.5px solid var(--color-primary);
    }
    .err-btn--ghost { background: var(--color-bg); color: var(--color-primary); }
    .err-btn:hover { opacity: 0.9; }
    .err-h2 { font-size: 1.2rem; margin: 0 0 1rem; }
    .err-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 3rem; }
    .err-cat {
      display: inline-block; padding: 0.45rem 0.85rem; border-radius: 100px;
      border: 1.5px solid var(--cat); color: var(--cat); background: var(--color-bg);
      font-size: 0.88rem; font-weight: 600; text-decoration: none;
    }
    .err-cat:hover { background: var(--cat); color: #fff; }
  </style>
</Base>
