---
import Base from '../../layouts/Base.astro';

const ferramentas = [
  {
    titulo: 'Misturador de cores',
    descricao: 'Mistura cores como se fossem tintas (não luz): azul + amarelo dá verde. Com proporções, comparação com o ecrã, jogo de adivinha e modo inverso (cor → receita).',
    href: '/misturador-de-cores/',
    cor: '#DB2777',
    emoji: '🎨'
  },
  {
    titulo: 'Conversor de folhas ↔ peso',
    descricao: 'Converte entre número de folhas e quilos, a partir do formato e da gramagem — nos dois sentidos. O cálculo que as gráficas fazem todos os dias.',
    href: '/conversor-de-papel/',
    cor: '#B45309',
    emoji: '📄'
  },
  {
    titulo: 'Resolução máxima de impressão',
    descricao: 'Carrega uma imagem e descobre o tamanho máximo a que pode ser impressa com qualidade (300 DPI, ou 150 para grande formato). A imagem fica no teu navegador.',
    href: '/resolucao-de-impressao/',
    cor: '#0EA5E9',
    emoji: '🖨️'
  },
  {
    titulo: 'Calculadora de lombada',
    descricao: 'A espessura exata da lombada de um livro ou catálogo (colado), a partir das páginas, da gramagem e do tipo de papel. Para fazer a capa sem erros.',
    href: '/calculadora-de-lombada/',
    cor: '#7C3AED',
    emoji: '📚'
  },
  {
    titulo: 'Saturação de cor (TAC)',
    descricao: 'Soma as percentagens CMYK de um fundo e avisa, com semáforo, se há tinta a mais (risco de não secar e decalcar). Ensina a fazer preto rico seguro.',
    href: '/saturacao-de-cor/',
    cor: '#DC2626',
    emoji: '🚦'
  },
  {
    titulo: 'Aproveitamento de folha',
    descricao: 'Quantos produtos saem de uma folha de máquina, com plano de corte visual e percentagem de desperdício. Para orçamentos e produção.',
    href: '/aproveitamento-de-folha/',
    cor: '#0D9488',
    emoji: '✂️'
  },
  {
    titulo: 'Inspetor de PDF para impressão',
    descricao: 'Larga um PDF e recebe um pré-flight simplificado: cores (CMYK vs RGB), resolução das imagens, fontes incorporadas e sangria. Análise 100% no teu navegador.',
    href: '/inspetor-de-pdf/',
    cor: '#4F46E5',
    emoji: '🔍'
  }
];
---

<Base
  title="Ferramentas | dicasgraficas.com"
  description="Ferramentas interativas e gratuitas para as artes gráficas: misturador de cores à pigmento e conversor de folhas para peso (kg)."
>
  <div class="static-page">
    <div class="container">
      <div class="category-header" style="border-bottom: none; padding-bottom: 1rem;">
        <div class="eyebrow">Interativo e gratuito</div>
        <h1>Ferramentas</h1>
        <p>Pequenas ferramentas práticas para o dia a dia das artes gráficas. Funcionam no navegador, sem instalar nada.</p>
      </div>

      <div class="categories-grid reveal-stagger" style="margin-top: 2rem;">
        {ferramentas.map(f => (
          <a href={f.href} class="category-card" style={`--cat: ${f.cor}`}>
            <div class="cat-icon" style="font-size: 26px; line-height: 1;">{f.emoji}</div>
            <h3>{f.titulo}</h3>
            <p>{f.descricao}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>
