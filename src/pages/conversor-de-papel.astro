---
import Base from '../layouts/Base.astro';
---

<Base
  title="Conversor de folhas e peso (kg) | dicasgraficas.com"
  description="Converte entre número de folhas e peso em kg, a partir do formato e da gramagem do papel — nos dois sentidos. A ferramenta de cálculo que as gráficas usam todos os dias."
>
  <div class="static-page">
    <div class="container">
      <div class="category-header" style="border-bottom: none; padding-bottom: 1rem; --cat: #B45309;">
        <div class="eyebrow">Ferramenta interativa</div>
        <h1>Conversor de folhas ↔ peso</h1>
        <p>
          Um dos cálculos mais usados numa gráfica: saber quantos <strong>quilos</strong> pesam X folhas de um
          determinado formato e gramagem — ou, ao contrário, quantas <strong>folhas</strong> cabem em X quilos.
          Escolhe o formato e a gramagem e converte nos dois sentidos.
        </p>
      </div>

      <iframe
        id="convFrame"
        src="/ferramentas/conversor-de-papel.html"
        title="Conversor de folhas e peso"
        loading="lazy"
        style="width: 100%; border: 1px solid var(--color-border); border-radius: 12px; min-height: 760px; background: #F9FAFB;"
      ></iframe>

      <p style="color: var(--color-text-secondary); font-size: 0.9rem; margin-top: 1rem;">
        O valor é o <strong>peso teórico</strong> (área × gramagem). O papel real tem uma pequena tolerância de
        fabrico e a humidade também influencia, por isso o peso de uma palete pode variar 1-3%.
      </p>
    </div>
  </div>

  <script is:inline>
    window.addEventListener('message', function (e) {
      if (e && e.data && e.data.type === 'mixer-height' && typeof e.data.height === 'number') {
        var f = document.getElementById('convFrame');
        if (f) f.style.height = (e.data.height + 24) + 'px';
      }
    });
  </script>
</Base>
