---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getCategory } from '../../data/categories';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Categorias presentes, com o slug correto vindo da fonte central
const usedCategories = [...new Set(allArticles.map(a => a.data.category))]
  .map(title => getCategory(title))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<Base
  title="Todos os artigos | dicasgraficas.com"
  description="Lista completa de artigos sobre artes gráficas, impressão, papel, acabamentos e história gráfica."
>
  <div class="articles-list">
    <div class="container">
      <div class="category-header" style="border-bottom: none; padding-bottom: 1rem;">
        <div class="eyebrow">Biblioteca</div>
        <h1>Todos os artigos</h1>
        <p>Explora todo o conteúdo publicado, ou filtra por categoria.</p>
      </div>

      <div class="filter-bar">
        <a href="/artigos/" class="active">Todos</a>
        {usedCategories.map(cat => (
          <a href={`/categorias/${cat.slug}/`} style={`--cat: ${cat.color}`}>
            {cat.title}
          </a>
        ))}
      </div>

      <div class="articles-grid">
        {sortedArticles.map(article => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            category={article.data.category}
            slug={article.id}
            pubDate={article.data.pubDate}
            readingTime={article.data.readingTime}
          />
        ))}
      </div>
    </div>
  </div>
</Base>
