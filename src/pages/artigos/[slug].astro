---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import ArticleAudio from '../../components/ArticleAudio.astro';
import { getCollection, render } from 'astro:content';
import { getCategory } from '../../data/categories';
import { byInteresse } from '../../data/article-order';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Find related articles (same category, exclude current)
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.data.category === article.data.category && a.id !== article.id)
  .sort(byInteresse)
  .slice(0, 3);

const cat = getCategory(article.data.category);
const categorySlug = cat?.slug ?? '';
const catColor = cat?.color ?? 'var(--color-primary)';
---

<Base
  title={article.data.title}
  description={article.data.description}
>
  <article style={`--cat: ${catColor}`}>
    <header class="article-header article-header--cat">
      <div class="container container-narrow">
        <div class="breadcrumb">
          <a href="/">Início</a>
          <span>/</span>
          <a href={`/categorias/${categorySlug}/`}>{article.data.category}</a>
          <span>/</span>
          <span>Artigo</span>
        </div>

        <ArticleCover color={catColor} icon={cat?.icon ?? ''} category={article.data.category} />

        <h1 class="article-title">{article.data.title}</h1>
        <p class="article-description">{article.data.description}</p>

        <div class="article-info">
          <span class="category">{article.data.category}</span>
          {article.data.readingTime && <span>{article.data.readingTime} de leitura</span>}
        </div>

        <ArticleAudio />
      </div>
    </header>

    <div class="article-body">
      <div class="container container-narrow">
        <Content />
      </div>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="related-articles">
      <div class="container">
        <h2>Continua a ler</h2>
        <div class="articles-grid">
          {relatedArticles.map(related => (
            <ArticleCard
              title={related.data.title}
              description={related.data.description}
              category={related.data.category}
              slug={related.id}
              pubDate={related.data.pubDate}
              readingTime={related.data.readingTime}
            />
          ))}
        </div>
        <p class="related-more">
          Vê todos os artigos de <a href={`/categorias/${categorySlug}/`}>{article.data.category}</a>
          · Encontraste um termo que não conheces? Consulta o <a href="/glossario/">glossário de artes gráficas</a>.
        </p>
      </div>
    </section>
  )}

  <style>
    .related-more { margin-top: 1.5rem; text-align: center; font-size: 0.92rem; color: var(--color-text-secondary, #6B7280); }
    .related-more a { color: var(--cat, #1B6FA8); font-weight: 600; }
  </style>
</Base>
