---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleAudio from '../../components/ArticleAudio.astro';
import { getCollection, render } from 'astro:content';
import { getCategory } from '../../data/categories';
import { byInteresse } from '../../data/article-order';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Find related articles (same category, exclude current)
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.data.category === article.data.category && a.id !== article.id)
  .sort(byInteresse)
  .slice(0, 3);

const cat = getCategory(article.data.category);
const categorySlug = cat?.slug ?? '';
const catColor = cat?.color ?? 'var(--color-primary)';

// Dados estruturados: diz ao Google que isto é um artigo, e onde encaixa no site
const siteUrl = 'https://dicasgraficas.com';
const articleUrl = `${siteUrl}/artigos/${article.id}/`;
const pubIso = new Date(article.data.pubDate).toISOString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.title,
    description: article.data.description,
    inLanguage: 'pt-PT',
    datePublished: pubIso,
    dateModified: pubIso,
    articleSection: article.data.category,
    keywords: article.data.keywords ?? undefined,
    image: `${siteUrl}/og-default.png`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
    author: { '@type': 'Organization', name: 'Onda Grafe', url: 'https://www.ondagrafe.pt' },
    publisher: { '@id': `${siteUrl}/#organization` }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: article.data.category, item: `${siteUrl}/categorias/${categorySlug}/` },
      { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl }
    ]
  }
];
---

<Base
  title={article.data.title}
  description={article.data.description}
  schema={schema}
>
  <article style={`--cat: ${catColor}`}>
    <header class="article-masthead">
      <div class="container container-narrow masthead-inner">
        <div class="breadcrumb">
          <a href="/">Início</a>
          <span>/</span>
          <a href={`/categorias/${categorySlug}/`}>{article.data.category}</a>
          <span>/</span>
          <span>Artigo</span>
        </div>

        <a href={`/categorias/${categorySlug}/`} class="masthead-cat">{article.data.category}</a>
        <h1 class="masthead-title">{article.data.title}</h1>
        <p class="masthead-desc">{article.data.description}</p>
        {article.data.readingTime && <div class="masthead-info">{article.data.readingTime} de leitura</div>}
      </div>
      <span class="masthead-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${cat?.icon ?? ''}</svg>`} />
      <span class="masthead-stripe" aria-hidden="true"></span>
    </header>

    <div class="container container-narrow article-audio-wrap">
      <ArticleAudio />
    </div>

    <div class="article-body">
      <div class="container container-narrow">
        <Content />
      </div>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="related-articles">
      <div class="container">
        <h2>Continua a ler</h2>
        <div class="articles-grid">
          {relatedArticles.map(related => (
            <ArticleCard
              title={related.data.title}
              description={related.data.description}
              category={related.data.category}
              slug={related.id}
              pubDate={related.data.pubDate}
              readingTime={related.data.readingTime}
            />
          ))}
        </div>
        <p class="related-more">
          Vê todos os artigos de <a href={`/categorias/${categorySlug}/`}>{article.data.category}</a>
          · Encontraste um termo que não conheces? Consulta o <a href="/glossario/">glossário de artes gráficas</a>.
        </p>
      </div>
    </section>
  )}

  <style>
    .related-more { margin-top: 1.5rem; text-align: center; font-size: 0.92rem; color: var(--color-text-secondary, #6B7280); }
    .related-more a { color: var(--cat, #1B6FA8); font-weight: 600; }
  </style>
</Base>
